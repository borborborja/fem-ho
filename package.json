{
  "name": "fem-ho",
  "version": "0.1.0",
  "private": true,
  "description": "Gestor de tasques personal i familiar, autoallotjat",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/contracts",
    "packages/design-system"
  ],
  "scripts": {
    "android:build": "cd apps/android && ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Android/Sdk}\" ./gradlew assembleDebug --console=plain",
    "android:tokens": "node tools/gen/tokens-compose.mjs",
    "build": "npm run build --workspace @fem-ho/contracts && npm run build --workspace @fem-ho/server && npm run build --workspace @fem-ho/web",
    "check": "node tools/checks/run-all.mjs",
    "check:audit-coverage": "node tools/checks/audit-coverage.mjs",
    "check:contrast": "node tools/checks/contrast-check.mjs",
    "check:css-classes": "node tools/checks/css-classes.mjs",
    "check:i18n-lint": "node tools/checks/i18n-lint.mjs",
    "check:no-hardcoded-colors": "node tools/checks/no-hardcoded-colors.mjs",
    "check:no-pinned-from-research": "node tools/checks/no-pinned-from-research.mjs",
    "check:openapi-diff": "node tools/checks/openapi-diff.mjs",
    "check:parser-parity": "node tools/checks/parser-parity.mjs",
    "check:tokens-parity": "node tools/checks/tokens-parity.mjs",
    "check:vocab-lint": "node tools/checks/vocab-lint.mjs",
    "contracts:generate": "npm run generate -w @fem-ho/contracts",
    "contracts:validate": "npm run validate -w @fem-ho/contracts",
    "dev:server": "npm run dev -w @fem-ho/server",
    "dev:web": "npm run dev -w @fem-ho/web",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:android": "node tools/i18n/strings-xml.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:android": "cd apps/android && ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Android/Sdk}\" ./gradlew :core-model:test :core-data:testDebugUnitTest --console=plain",
    "test:fresh-install": "./tools/fresh-install/run.sh",
    "test:postgres": "FEMHO_TEST_POSTGRES_URL=\"${FEMHO_TEST_POSTGRES_URL:-postgres://postgres:femho@localhost:55432/femho_test}\" vitest run",
    "test:proxy-matrix": "./tools/proxy-matrix/run.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:i18n-parity": "node tools/checks/i18n-parity.mjs",
    "check:i18n-keys-exist": "node tools/checks/i18n-keys-exist.mjs",
    "check:no-ignored-sources": "node tools/checks/no-ignored-sources.mjs",
    "check:scope-predicate": "node tools/checks/scope-predicate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
