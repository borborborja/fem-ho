{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/weather/**",
              "ui_kits/plou_app/**",
              "ui_kits/plou_web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto))/i]",
        "message": "Font not provided by the design system. Available: Roboto."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:place|headline|detail|time|intensity|size|actions|key|ref|className|style|children)$/]",
        "message": "<AlertScreen> doesn't accept that prop. Declared props: place, headline, detail, time, intensity, size, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertScreen'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:mobile|desktop)$/]",
        "message": "<AlertScreen> size must be one of 'mobile' | 'desktop'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconPosition|block|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconPosition, block, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|danger|glass|onAlert)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'danger' | 'glass' | 'onAlert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|density|kicker|title|meta|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, density, kicker, title, meta, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|washCool|washWarm|glass)$/]",
        "message": "<Card> tone must be one of 'surface' | 'washCool' | 'washWarm' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:tile|tight|mobile|comfy)$/]",
        "message": "<Card> density must be one of 'tile' | 'tight' | 'mobile' | 'comfy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartLegendItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|key|ref|className|style|children)$/]",
        "message": "<ChartLegendItem> doesn't accept that prop. Declared props: label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ChoiceChip> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|width|onClose|children|footer|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, width, onClose, children, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|children|key|ref|className|style|children)$/]",
        "message": "<GlassBar> doesn't accept that prop. Declared props: shape, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassBar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|sheet)$/]",
        "message": "<GlassBar> shape must be one of 'pill' | 'sheet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HourlyRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|temp|wind|cond|icon|precip|key|ref|className|style|children)$/]",
        "message": "<HourlyRow> doesn't accept that prop. Declared props: time, temp, wind, cond, icon, precip."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|label|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: tone, size, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|glass|glassOutlined|gradient)$/]",
        "message": "<IconButton> tone must be one of 'neutral' | 'glass' | 'glassOutlined' | 'gradient'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|meta|intensity|schedule|notifType|notice|dot|density|actions|onEdit|onCheck|onDelete|key|ref|className|style|children)$/]",
        "message": "<LocationCard> doesn't accept that prop. Declared props: name, status, meta, intensity, schedule, notifType, notice, dot, density, actions, onEdit, onCheck, onDelete."
      },
      {
        "selector": "JSXOpeningElement[name.name='LocationCard'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:mobile|comfy)$/]",
        "message": "<LocationCard> density must be one of 'mobile' | 'comfy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapControlItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|glyph|onClick|key|ref|className|style|children)$/]",
        "message": "<MapControlItem> doesn't accept that prop. Declared props: label, glyph, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapControlItem'] > JSXAttribute[name.name='glyph'] > Literal[value!=/^(?:layers)$/]",
        "message": "<MapControlItem> glyph must be one of 'layers'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|active|children|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, active, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrecipPoint'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|value|key|ref|className|style|children)$/]",
        "message": "<PrecipPoint> doesn't accept that prop. Declared props: time, value."
