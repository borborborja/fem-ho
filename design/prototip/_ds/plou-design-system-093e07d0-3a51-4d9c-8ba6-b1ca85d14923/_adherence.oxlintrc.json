      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:mobile|desktop)$/]",
        "message": "<StatTile> size must be one of 'mobile' | 'desktop'."
