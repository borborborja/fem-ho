        "selector": "JSXOpeningElement[name.name='SettingsGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|note|density|children|key|ref|className|style|children)$/]",
        "message": "<SettingsGroup> doesn't accept that prop. Declared props: title, note, density, children."
