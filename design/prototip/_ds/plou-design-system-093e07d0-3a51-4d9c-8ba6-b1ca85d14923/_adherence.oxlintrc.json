      {
        "selector": "JSXOpeningElement[name.name='RadarViewport'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|radius|fullBleed|children|key|ref|className|style|children)$/]",
        "message": "<RadarViewport> doesn't accept that prop. Declared props: image, radius, fullBleed, children."
