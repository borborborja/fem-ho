        "selector": "JSXOpeningElement[name.name='SettingsGroup'] > JSXAttribute[name.name='density'] > Literal[value!=/^(?:mobile|comfy)$/]",
        "message": "<SettingsGroup> density must be one of 'mobile' | 'comfy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:min|max|step|value|onChange|label|valueLabel|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: min, max, step, value, onChange, label, valueLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|size|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, size."
