{
  "name": "@fem-ho/contracts",
  "version": "0.9.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Font de veritat de l'API i tot el que web, servidor i Android han de compartir",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi.yaml",
    "./i18n/ca.json": "./i18n/ca.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript openapi.yaml -o src/generated/api.ts",
    "typecheck": "tsc --noEmit",
    "validate": "redocly lint openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "2.44.2",
    "openapi-typescript": "7.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
