# Fem-ho · variables d'entorn
#
# Copia aquest fitxer a `.env` i toca el que calgui. `.env` està al `.gitignore`: hi van
# els secrets d'aquesta instància i no han de sortir mai del servidor.
#
# Docker Compose llegeix `.env` sol, del mateix directori del `compose.yaml`. Totes les
# variables porten el prefix `FEMHO_`, i les que són secretes accepten el sufix `_FILE`
# per llegir-les d'un fitxer, que és el que fa servir el mecanisme de secrets de Docker.
# La llista sencera és a `docs/12` §3.

# ----------------------------------------------------------------- qui pot entrar

# Deixa que la gent es faci un compte des de la pantalla de login.
#
# **El primer que es registri serà administrador** —amb la base buida, registrar-se és el
# primer arrencament— i tots els següents seran membres normals.
#
# Pensa-t'ho si la instància és a internet: obert vol dir obert, i qualsevol que en trobi
# l'adreça es pot fer un compte. Per a una casa, el camí habitual és deixar-ho a `false` i
# convidar la gent des d'Ajustos ▸ Administració, que a més et deixa dir quin paper té
# cadascú.
FEMHO_ALLOW_REGISTRATION=false

# La forma llarga de la mateixa cosa, per si vols el mode `invite`:
#
#   disabled  ningú es pot registrar; les altes les fa l'administrador
#   invite    igual, però amb els enllaços de convit
#   open      qualsevol es pot fer un compte
#
# `FEMHO_ALLOW_REGISTRATION=true` vol dir `open` i `false` vol dir `disabled`. Si en poses
# les dues dient coses diferents **el servidor no arrenca**: dues variables que es
# contradiuen deixarien la instància oberta o tancada per accident, i triar-ne una per
# defecte seria decidir-ho jo per tu.
# FEMHO_REGISTRATION=disabled

# ---------------------------------------------------------------------- avatars

# Deixa que les fotos de perfil surtin de Gravatar.
#
# **Apagat per defecte, i no per prudència genèrica.** Encendre-ho vol dir que el servidor
# de casa comença a preguntar a un tercer —Automattic— per la cara de cadascú. El que se
# li envia és el hash del correu, i això **no és anonimat**: per a una adreça que algú ja
# sospita, comprovar-la és calcular-ne el hash i comparar. O sigui que encendre-ho és dir
# a Gravatar quines adreces hi ha en aquesta casa.
#
# El que sí que es fa bé, si l'encens:
#
#   - Les peticions les fa **el servidor**, no el navegador de cadascú: Gravatar veu una
#     màquina i no la IP de tota la casa a cada càrrega de pàgina.
#   - La foto es guarda al volum, o sigui que **segueix sortint sense connexió**.
#   - Cada persona ho pot treure des d'Ajustos ▸ Perfil, perquè el correu és seu.
#
# Amb això apagat, els avatars són les inicials i no es pregunta res de ningú.
FEMHO_GRAVATAR=false

# ------------------------------------------------------------------- l'essencial

# **Obligatòria en producció.** Sense això, CalDAV i els enllaços compartits generen URL
# incorrectes, que és la causa número u de problemes.
FEMHO_BASE_URL=https://femho.example.com

# El nom que veu qui s'hi connecta, i el que publica el manifest de federació.
FEMHO_INSTANCE_NAME=Fem-ho

FEMHO_DATABASE_URL=sqlite:///data/femho.db

# El secret de la instància. Si no se'n dona cap, se'n genera un sol cop al volum de dades.
# Genera'l amb: openssl rand -hex 32
# FEMHO_SECRET=

# El rang del proxy invers, perquè `X-Forwarded-For` es pugui creure.
# FEMHO_TRUSTED_PROXIES=172.16.0.0/12

# Mida màxima d'un adjunt, en MB.
# FEMHO_MAX_UPLOAD_MB=25
