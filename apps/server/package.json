{
  "name": "@fem-ho/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de Fem-ho: API REST, CalDAV, MCP, SSE i feines programades",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:codegen": "node ./scripts/codegen.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fem-ho/contracts": "*",
    "@node-rs/argon2": "2.0.2",
    "better-sqlite3": "13.0.3",
    "fastify": "5.11.2",
    "kysely": "0.29.4",
    "pg": "8.22.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.20.4",
    "kysely-codegen": "0.20.0"
  }
}
