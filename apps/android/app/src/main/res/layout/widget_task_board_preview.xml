<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/femho_widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:src="@drawable/femho_dot" android:tint="@color/femho_ink_soft" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/board_column_inbox" android:textColor="@color/femho_ink" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="@color/femho_ink_soft" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/femho_widget_tile" android:padding="8dp" android:orientation="vertical">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@color/femho_card_border" />
                <View android:layout_width="32dp" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/femho_card_border" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="end" android:layout_marginTop="12dp" android:src="@drawable/femho_arrow" android:tint="@color/femho_ink_soft" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:src="@drawable/femho_dot" android:tint="@color/femho_preview_plou_blue" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/board_column_todo" android:textColor="@color/femho_ink" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="@color/femho_ink_soft" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/femho_widget_tile" android:padding="8dp" android:orientation="vertical">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@color/femho_card_border" />
                <View android:layout_width="32dp" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/femho_card_border" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="end" android:layout_marginTop="12dp" android:src="@drawable/femho_arrow" android:tint="@color/femho_ink_soft" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:src="@drawable/femho_dot" android:tint="@color/femho_preview_plou_orange" android:importantForAccessibility="no" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/board_column_doing" android:textColor="@color/femho_ink" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="@color/femho_ink_soft" android:textSize="11sp" />
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="11dp" android:src="@drawable/femho_open" android:tint="@color/femho_ink_soft" android:contentDescription="@string/widget_taskboard_open" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/femho_widget_tile" android:padding="8dp" android:orientation="vertical">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@color/femho_card_border" />
                <View android:layout_width="32dp" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/femho_card_border" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="end" android:layout_marginTop="12dp" android:src="@drawable/femho_arrow" android:tint="@color/femho_ink_soft" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
