<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/femho_widget_surface">
    <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"
        android:text="@string/widget_taskboard_title" android:textColor="@color/femho_ink" android:textSize="15sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_column_inbox" android:textColor="@color/femho_ink" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
            <View android:layout_width="24dp" android:layout_height="3dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@color/femho_ink_soft" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/femho_widget_tile" android:padding="12dp" android:orientation="vertical">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@color/femho_card_border" />
                <View android:layout_width="32dp" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/femho_card_border" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="end" android:layout_marginTop="12dp" android:src="@drawable/femho_arrow" android:tint="@color/femho_ink_soft" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_column_todo" android:textColor="@color/femho_ink" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
            <View android:layout_width="24dp" android:layout_height="3dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@color/femho_preview_plou_blue" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/femho_widget_tile" android:padding="12dp" android:orientation="vertical">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@color/femho_card_border" />
                <View android:layout_width="32dp" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/femho_card_border" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="end" android:layout_marginTop="12dp" android:src="@drawable/femho_arrow" android:tint="@color/femho_ink_soft" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/board_column_doing" android:textColor="@color/femho_ink" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" />
            <View android:layout_width="24dp" android:layout_height="3dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@color/femho_preview_plou_orange" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/femho_widget_tile" android:padding="12dp" android:orientation="vertical">
                <View android:layout_width="match_parent" android:layout_height="4dp" android:background="@color/femho_card_border" />
                <View android:layout_width="32dp" android:layout_height="4dp" android:layout_marginTop="8dp" android:background="@color/femho_card_border" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="end" android:layout_marginTop="12dp" android:src="@drawable/femho_arrow" android:tint="@color/femho_ink_soft" android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
