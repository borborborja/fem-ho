<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Els recordatoris arriben per UnifiedPush (docs/11 §1); el permís de
         notificació és obligatori des d'Android 13. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FemhoApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Femho">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Femho">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Els convits arriben com a deep links: femho://join/{token} per entrar a
              l'àmbit d'algú altre i femho://invite/{token} per crear el compte de la
              instància (docs/10 §7). El mateix intent respon als https del servidor.
              Van en dos filters: un `data` per esquema i un altre per als https, que
              són els que porten el path de la ruta.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="femho" android:host="join" />
                <data android:scheme="femho" android:host="invite" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="femho.app" android:pathPrefix="/join/" />
                <data android:scheme="https" android:host="femho.app" android:pathPrefix="/invite/" />
            </intent-filter>
            <!--
              El full de compartir: el text que hi arriba es converteix en una tasca a la
              bústia (requestQuickAdd amb el draft). Res d'imatges ni URL: només text.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Per obrir l'exportació CSV del Registre amb ACTION_VIEW: una URI `file://`
          és blocada des d'Android 7, i això és el que l'hi permet.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!--
          El receptor d'UnifiedPush. Els tres primers filtres són els que la
          especificació defineix; el quart és el que el distribuïdor fa servir per
          descobrir les apps que en volen (docs/11 §1).
        -->

        <!--
          Els widgets de la pantalla d'inici (docs/03 §9).

          `exported="true"` no és una tria: el sistema d'AppWidget és qui envia les
          emissions, i un receptor no exportat no en rebria cap. No hi ha cap permís
          propi perquè no hi ha res que ningú altre pugui demanar-li.
        -->
        <receiver
            android:name=".widget.BoardWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_board_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_board_info" />
        </receiver>


        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
