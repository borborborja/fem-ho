<?xml version="1.0" encoding="utf-8"?>
<!--
  Una columna del tauler. Radi de targeta (16dp), com a l'app.

  **Porta vora.** A l'app el fons de columna és al 2% i es distingeix perquè seu damunt
  d'un fons de pàgina tenyit; damunt de la superfície blanca d'un widget desapareix del
  tot. La vora és el que fa que la graella es llegeixi com a graella.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/femho_column_bg" />
    <stroke android:width="1dp" android:color="@color/femho_card_border" />
    <corners android:radius="16dp" />
</shape>
